#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" == /* ]] || script_path="${script_dir}/${script_path}"
done
SBX_KIT_ROOT="$(cd "$(dirname "$script_path")/.." && pwd)"
SBX_CTL="${SBX_KIT_ROOT}/bin/sandboxctl"
source "${SBX_KIT_ROOT}/adapters/registry.sh"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}

usage() {
  cat <<'EOF'
Agent Sandbox Kit

Usage:
  sbx <agent> <action> <project> [arguments]
  sbx init <project>
  sbx upgrade [--dry-run] <project>
  sbx build
  sbx version
  sbx context <project> [add [paths...] | list | remove <names...>]

Agents: codex, opencode
Actions: run, login, auth-status, logout, doctor, shell, exec, reset-auth

Examples:
  sbx codex run my-project
  sbx opencode login my-project
  sbx codex exec my-project -- npm test

With no context action, paste Windows Copy as path values, one per line.
Finish with a blank line. Context is read-only; /data is writable outside Git.
EOF
}

main() {
  local first="${1:-}"
  case "$first" in
    help|-h|--help|'') usage; [[ -n "$first" ]] || return 2; return 0 ;;
    init|build|upgrade|version|context)
      shift
      exec "$SBX_CTL" "$first" "$@"
      ;;
  esac

  local agent="$first" action="${2:-}" handler
  sbx_adapter_is_registered "$agent" \
    || die "unknown agent: ${agent:-<missing>} (expected: ${SBX_AGENTS[*]})"
  [[ -n "$action" ]] || die "missing action for agent $agent"
  handler="$(sbx_adapter_handler "$agent" "$action")"
  [[ -n "$handler" ]] \
    || die "invalid action '$action' for agent '$agent' (expected: ${SBX_ADAPTER_ACTIONS[$agent]})"
  shift 2
  exec "$SBX_CTL" "$agent" "$action" "$@"
}

main "$@"

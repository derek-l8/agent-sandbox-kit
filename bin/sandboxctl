  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl auth-status-opencode <slug>"
  load_project "$slug"
  ensure_project_layout
  ensure_opencode_image
  prepare_opencode_auth_command
  run_opencode_command create_opencode_login_container false \
    opencode auth list
}

cmd_logout_opencode() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl logout-opencode <slug>"
  load_project "$slug"
  ensure_project_layout
  ensure_opencode_image
  prepare_opencode_auth_command
  run_opencode_command create_opencode_login_container true \
    opencode auth logout
}

cmd_destroy_opencode_auth() {
  local slug="${1:-}"
  local confirmation="${2:-}"
  [[ -n "$slug" && "$confirmation" == '--yes' ]] \
    || die "usage: sandboxctl destroy-opencode-auth <slug> --yes"
  load_project "$slug"
  local volume
  volume="$(opencode_auth_volume_name)"
  docker volume inspect "$volume" >/dev/null 2>&1 || die "OpenCode auth volume does not exist: $volume"
  docker volume rm "$volume"
  note "Removed project OpenCode authentication volume: $volume"
}

cmd_doctor_opencode() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl doctor-opencode <slug>"
  require_command docker
  require_command git
  docker info >/dev/null
  load_project "$slug"
  ensure_project_layout
  ensure_images
  ensure_opencode_image
  load_protected_mounts
  note "PASS: Docker daemon is available"
  note "PASS: project layout is complete"
  note "PASS: normal Git metadata directory exists"
  note "PASS: pinned v2 images and labels match"
  note "PASS: pinned OpenCode image, version $OPENCODE_VERSION, and integrity labels match"
  note "PASS: protected paths are valid"
  note "RESULT: project doctor passed (opencode)"
}

cmd_package() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl package <slug>"
  load_project "$slug"
  ensure_project_layout
  git -C "$REPO_DIR" rev-parse --verify HEAD >/dev/null 2>&1 \
    || die "repository needs a baseline commit before packaging"
  local stamp destination file
  stamp="$(date -u +'%Y%m%dT%H%M%SZ')"
  destination="${OUTBOX_DIR}/review-${stamp}"
  mkdir -p "$destination"
  git -C "$REPO_DIR" status --short > "$destination/git-status.txt"
  git -C "$REPO_DIR" diff --stat HEAD > "$destination/diff-stat.txt"
  git -C "$REPO_DIR" diff --binary --full-index HEAD > "$destination/changes.patch"
  while IFS= read -r -d '' file; do
    git -C "$REPO_DIR" diff --binary --full-index --no-index \
      -- /dev/null "$REPO_DIR/$file" >> "$destination/changes.patch" || true
  done < <(git -C "$REPO_DIR" ls-files --others --exclude-standard -z)
  for file in REPORT.md SOURCES.md TEST_RESULTS.md; do
    if [[ -f "$REPO_DIR/.agent/$file" ]]; then
      cp "$REPO_DIR/.agent/$file" "$destination/$file"
    fi
  done
  (
    cd "$destination"
    find . -type f ! -name SHA256SUMS.txt -print0 \
      | sort -z \
      | xargs -0 sha256sum > SHA256SUMS.txt
  )
  note "$destination"
}

usage() {
  cat <<'EOF'
Usage: sandboxctl <command> [arguments]

Commands:
  init <slug>                 Create an isolated project directory layout
  build                       Build the pinned v2 images (Codex, offline, OpenCode)
  doctor <slug>               Validate host, project, and image prerequisites
  login <slug>                Sign in through ChatGPT device authorization
  auth-status <slug>          Check whether the project auth volume is signed in
  logout <slug>               Remove saved credentials through Codex
  destroy-auth <slug> --yes   Delete the project auth volume
  run <slug> [prompt]         Start the interactive autonomous Codex session
  shell <slug>                Start a diagnostic shell in the networked boundary
  exec <slug> -- <command>    Run a noninteractive command in the networked boundary
  offline <slug> -- <command> Run a command against a fresh offline source copy
  package <slug>              Produce a trusted WSL review bundle

OpenCode commands:
  doctor-opencode <slug>             Validate prerequisites including the OpenCode image
  login-opencode <slug>              Authenticate OpenCode without mounting a project
  auth-status-opencode <slug>        List connected OpenCode providers (no secrets)
  logout-opencode <slug>             Remove saved OpenCode provider credentials
  destroy-opencode-auth <slug> --yes Delete the OpenCode project auth volume
  run-opencode <slug> [args]         Start the interactive OpenCode session
  shell-opencode <slug>              Start a diagnostic shell in the OpenCode boundary
  exec-opencode <slug> -- <command>  Run a noninteractive command in the OpenCode boundary
EOF
}

main() {
  read_versions
  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 2; }
  shift
  case "$command" in
    init) cmd_init "$@" ;;
    build) cmd_build "$@" ;;
    doctor) cmd_doctor "$@" ;;
    login) cmd_login "$@" ;;
    auth-status) cmd_auth_status "$@" ;;
    logout) cmd_logout "$@" ;;
    destroy-auth) cmd_destroy_auth "$@" ;;
    run) cmd_run "$@" ;;
    shell) cmd_shell "$@" ;;
    exec) cmd_exec "$@" ;;
    offline) cmd_offline "$@" ;;
    package) cmd_package "$@" ;;
    doctor-opencode) cmd_doctor_opencode "$@" ;;
    login-opencode) cmd_login_opencode "$@" ;;
    auth-status-opencode) cmd_auth_status_opencode "$@" ;;
    logout-opencode) cmd_logout_opencode "$@" ;;
    destroy-opencode-auth) cmd_destroy_opencode_auth "$@" ;;
    run-opencode) cmd_run_opencode "$@" ;;
    shell-opencode) cmd_shell_opencode "$@" ;;
    exec-opencode) cmd_exec_opencode "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"

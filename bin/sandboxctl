  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl auth-status <slug>"
  load_project "$slug"
  ensure_project_layout
  ensure_images
  local container_id
  container_id="$(create_login_container false \
    codex login status)"
  run_created_container "$container_id" false
}

cmd_logout() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl logout <slug>"
  load_project "$slug"
  ensure_project_layout
  ensure_images
  local container_id
  container_id="$(create_login_container false \
    codex logout)"
  run_created_container "$container_id" false
}

cmd_destroy_auth() {
  local slug="${1:-}"
  local confirmation="${2:-}"
  [[ -n "$slug" && "$confirmation" == '--yes' ]] \
    || die "usage: sandboxctl destroy-auth <slug> --yes"
  load_project "$slug"
  local volume
  volume="$(auth_volume_name)"
  docker volume inspect "$volume" >/dev/null 2>&1 || die "auth volume does not exist: $volume"
  docker volume rm "$volume"
  note "Removed project authentication volume: $volume"
}

# Runs an OpenCode task/auth container while guaranteeing that the post-command
# authentication-volume prune always executes — after success AND failure — and
# preserves the original command exit status. A failed prune produces a visible
# nonzero result instead of silent success.
run_opencode_command() {
  local create_fn="$1"
  local interactive="$2"
  shift 2
  local exit_code=0 container_id=""
  container_id="$("$create_fn" "$interactive" "$@")" || exit_code=$?
  if [[ -n "$container_id" ]]; then
    run_created_container "$container_id" "$interactive" || exit_code=$?
  fi
  if ! finish_opencode; then
    [[ "$exit_code" -ne 0 ]] || exit_code=1
  fi
  return "$exit_code"
}

cmd_run_opencode() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl run-opencode <slug> [opencode arguments]"
  shift
  load_project "$slug"
  ensure_project_layout
  ensure_images
  ensure_opencode_image
  acquire_session_lock opencode
  prepare_opencode_session
  run_opencode_command create_opencode_container true \
    opencode --pure "$@"
}

cmd_shell_opencode() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl shell-opencode <slug>"
  load_project "$slug"
  ensure_project_layout
  ensure_images
  ensure_opencode_image
  acquire_session_lock opencode-shell
  prepare_opencode_session
  run_opencode_command create_opencode_container true bash
}

cmd_exec_opencode() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl exec-opencode <slug> -- <command>"
  shift
  [[ "${1:-}" == '--' ]] || die "usage: sandboxctl exec-opencode <slug> -- <command>"
  shift
  [[ "$#" -gt 0 ]] || die "a command is required"
  load_project "$slug"
  ensure_project_layout
  ensure_images
  ensure_opencode_image
  acquire_session_lock opencode-exec
  prepare_opencode_session
  run_opencode_command create_opencode_container false "$@"
}

cmd_login_opencode() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: sandboxctl login-opencode <slug>"
  load_project "$slug"
  ensure_project_layout
  ensure_opencode_image
  prepare_opencode_auth_command
  run_opencode_command create_opencode_login_container true \
    opencode auth login
}

